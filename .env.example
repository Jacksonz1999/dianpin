# Copy this file to .env for local development (never commit .env itself).
# In production (Railway), DATABASE_URL is injected by the platform via the
# service's environment variables — do not put production credentials here
# or anywhere in the repo.

# Local Postgres connection string used by lib/db.ts, drizzle.config.ts and
# db/seed.ts. Example for a local `postgres` superuser on the default port:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dianpin

# --- Auth (lib/auth/) ---

# Base URL used to build the magic-link that gets emailed. Falls back to
# http://localhost:3000 if unset, so this only needs to be set in
# production (already listed in AGENTS.md §7's Railway env block).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required. Signs session cookies and the login-request CAPTCHA token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it logs every signed-in user out.
AUTH_SECRET=

# Which login channel is active. "email" is the only one that actually
# sends anything in v1 (AGENTS.md §4); "whatsapp" is a reserved slot that
# throws a clear "not implemented" error if selected — see
# lib/auth/providers/whatsapp.ts.
AUTH_PROVIDER=email

# Optional for local dev: without SMTP_URL set, lib/auth/providers/email.ts
# logs the magic-link URL to the server console instead of emailing it, so
# the login flow is still fully testable without real mail infrastructure.
# Format: smtp://user:pass@host:port
SMTP_URL=
EMAIL_FROM=noreply@dianpin-jobs.es

# --- Reserved for future work packages ---
#
# Not read by any code yet. Listed here only because AGENTS.md §7 already
# names them as the Railway env vars this project will need once their
# features land, so this file stays a complete reference of the full set.

# WhatsApp OTP provider (AGENTS.md §4 first choice; lib/auth/providers/whatsapp.ts
# is currently a stub that throws "not implemented" — wire this in when it's built).
WHATSAPP_TOKEN=

# Fallback SMS provider credentials, only relevant if the project ever adopts
# the "dedicated long code" exception from AGENTS.md §4 instead of WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cloudflare R2 (or S3-compatible) object storage for store/job photos —
# AGENTS.md §7 is explicit that images must not be served from Railway
# itself. Needed once image upload is implemented.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
