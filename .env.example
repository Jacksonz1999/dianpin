# Copy this file to .env for local development (never commit .env itself).
# In production (Railway), DATABASE_URL is injected by the platform via the
# service's environment variables — do not put production credentials here
# or anywhere in the repo.

# Local Postgres connection string used by lib/db.ts, drizzle.config.ts and
# db/seed.ts. Example for a local `postgres` superuser on the default port:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dianpin
